@model IEnumerable<CatalogManager.Domain.Entities.Product>

@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/product-landing.css" asp-append-version="true" />

<section class="py-4 py-lg-5">
    <div class="d-flex align-items-start align-items-md-center justify-content-between flex-column flex-md-row gap-3 mb-4">
        <div>
            <span class="product-section-kicker">EXPLORE OUR CATALOG</span>
            <h1 class="fw-bold mb-2">Products</h1>
            <p class="text-secondary mb-0">Choose a product to explore its dedicated landing page.</p>
        </div>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary">Add Product</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center p-5 border rounded-4 bg-light">
            <h2 class="h4">No products yet</h2>
            <p class="text-secondary">Create a category and a store, then add your first product.</p>
            <a asp-action="Create" class="btn btn-primary">Add Product</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top"
                                 style="height:230px;object-fit:cover;background:#edf2f8" loading="lazy"
                                 onerror="this.onerror=null;this.style.display='none';" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center text-secondary fw-semibold"
                                 style="height:230px;background:#edf2f8">
                                No product image
                            </div>
                        }
                        <div class="card-body d-flex flex-column p-4">
                            <div class="mb-2"><span class="badge text-bg-light border">@(product.Category?.Name ?? "Uncategorized")</span></div>
                            <h2 class="h5 fw-bold card-title">@product.Name</h2>
                            <p class="text-secondary small mb-3">Store: @(product.Store?.Name ?? "Unavailable")</p>
                            <p class="h4 text-primary fw-bold mt-auto mb-3">@product.Price.ToString("N2") UAH</p>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                               class="btn btn-primary mb-2">View product</a>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm flex-fill">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm flex-fill">Delete</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>